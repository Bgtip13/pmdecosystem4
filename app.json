{
  "expo": {
    "name": "PMD Ecosystem 4.0",
    "slug": "pmd-ecosystem",
    "version": "4.0.3",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "pmdecosystem",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.primamandiridistribusi.pmdecosystem"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7f1a5fd-d466-4443-8c91-2e10f5493147"
      }
    },
        "runtimeVersion": "4.0.3",
    "updates": {
      "url": "https://u.expo.dev/b7f1a5fd-d466-4443-8c91-2e10f5493147"
    }
  }
}
